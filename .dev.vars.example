# Only needed for the optional accounts feature (sign-in and saved returns).
# The calculator runs without this file. Copy to .dev.vars and fill in.

# Any long random string, for example the output of: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The origin the dev server runs on.
APP_URL=http://localhost:3000

# Optional. Without a Resend key the sign-in code is printed to the dev log.
# RESEND_API_KEY=replace-with-your-resend-api-key
# MAIL_FROM=Thai Tax Calculator <noreply@example.com>
