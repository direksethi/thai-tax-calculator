{
  "name": "thai-tax-calculator",
  "version": "0.1.0",
  "private": true,
  "description": "Thai personal income tax engine and calculator, with a company-versus-personal comparison, in English and Thai.",
  "license": "MIT",
  "author": "Direk Sethi (https://direksethi.com)",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "tsc --noEmit && tsc -p tsconfig.engine.json && vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:engine": "tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@fontsource-variable/anuphan": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "6.28.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
